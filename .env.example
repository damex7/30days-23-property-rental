# Copy to .env.local (never commit .env.local) and fill in.

# Neon: the POOLED connection string (host contains "-pooler"), from a NEW
# Neon project or branch just for Day 23.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
# Optional: the direct (unpooled) string, used by npm run db:migrate only.
DATABASE_URL_UNPOOLED=

# The site's public address. Every link in every email is built from this,
# never from the request's Host header.
APP_URL=http://localhost:3023

# Email. Leave RESEND_API_KEY empty to print emails to the terminal instead.
RESEND_API_KEY=
EMAIL_FROM=Staybook <onboarding@resend.dev>

# Paystack TEST secret key (starts sk_test_). Dashboard → Settings → API Keys.
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Vercel Blob read-write token (Vercel → Storage → Blob → your store → .env.local tab).
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxx

# Long random strings (at least 32 characters each), e.g. from:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET=
ICAL_SIGNING_SECRET=

# Passwords for the seeded accounts (npm run db:seed). At least 8 characters.
SEED_USER_PASSWORD=
SEED_ADMIN_PASSWORD=

# "Try as a guest" / "Look around as a host" buttons. Set to false to hide them.
DEMO_MODE=true
